{
  "name": "vin-relay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "pages:build": "tsc --noEmit && vite build --config vite.pages.config.ts",
    "preview": "vite preview --host",
    "demo:build": "PWA_DISABLED=1 bun run scripts/build-demo.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "seed:wmi": "bun run scripts/build-wmi-seed.ts",
    "build:ocr": "bun run scripts/build-ocr-assets.ts",
    "test:e2e": "playwright test --project=desktop",
    "test:e2e:android": "playwright test --project=pixel-7 --project=galaxy-s9",
    "bench:camera": "python3 bench/make-fake-camera.py && node bench/make-qr-camera.mjs \"$(bun -e 'import{encodePayload}from\"./src/lib/payload/codec\";console.log(`https://vinrelay.example/#/i?d=${encodePayload({v:1,vin:\"1HGCM82633A004352\",y:\"2003\",mk:\"HONDA\",md:\"Accord\",u:\"UNIT-42\"})}`)')\" bench/fake-qr.y4m",
    "pretest:e2e": "python3 bench/make-fake-camera.py && node bench/make-qr-camera.mjs \"$(bun -e 'import{encodePayload}from\"./src/lib/payload/codec\";console.log(`https://vinrelay.example/#/i?d=${encodePayload({v:1,vin:\"1HGCM82633A004352\",y:\"2003\",mk:\"HONDA\",md:\"Accord\",u:\"UNIT-42\"})}`)')\" bench/fake-qr.y4m",
    "bench": "bun run bench/run.ts --json bench/report.json",
    "bench:quick": "bun run bench/run.ts --quick --count 8",
    "mutate": "stryker run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "axe-core": "^4.13.0",
    "bwip-js": "^4.11.4",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.0.0",
    "fake-indexeddb": "^6.2.2",
    "fast-check": "^4.9.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "4.1.11"
  }
}
