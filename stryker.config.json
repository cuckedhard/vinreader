{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "A23 (§13.5). The mutation half of the gate: 'a suite that kills mutants is the only proof the tests are real'. Scope mirrors vitest.config.ts's coverage `include`/`exclude` exactly, so the two halves of the gate measure the same files.",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.stryker.config.ts"
  },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/lib/**/*.ts",
    "src/features/scan/scanMachine.ts",
    "!src/lib/**/*.test.ts",
    "!src/lib/**/test-setup.ts",
    "!src/lib/**/*.testutil.ts",
    "!src/lib/vin/types.ts"
  ],
  "ignorePatterns": [
    "dist",
    "dev-dist",
    "coverage",
    "test-results",
    "playwright-report",
    "bench/corpus",
    "bench/*.y4m",
    "supabase/.temp"
  ],
  "concurrency": 3,
  "timeoutMS": 20000,
  "timeoutFactor": 2.5,
  "dryRunTimeoutMinutes": 10,
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "reporters": ["clear-text", "progress", "html", "json"],
  "clearTextReporter": {
    "reportTests": false,
    "maxTestsToLog": 0,
    "skipFull": false
  },
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "tempDirName": ".stryker-tmp"
}
